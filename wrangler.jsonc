{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ratey-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "secrets": { "required": ["INVITE_CODE", "GEOAPIFY_KEY"] },
  "vars": { "ALLOWED_ORIGIN": "https://aaabawgte.github.io" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ratey",
      "database_id": "9b729732-171a-4ee0-9c79-598a44b2f20b",
      "migrations_dir": "migrations",
    },
  ],
}
