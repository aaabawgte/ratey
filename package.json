{
  "name": "ratey",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src worker",
    "preview": "vite preview",
    "api:dev": "wrangler dev --var ALLOWED_ORIGIN:http://localhost:5173",
    "api:types": "wrangler types worker/env.d.ts",
    "api:check": "npm run api:types && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^1.54.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
